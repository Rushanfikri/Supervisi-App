rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to validate Sync payload
    function isValidSyncPayload(data) {
      return data.keys().hasAll(['timestamp'])
        && data.timestamp is int;
    }

    // Helper to validate Draft payload
    function isValidDraftDocument(data) {
      return data.keys().hasAll(['name', 'unit', 'view', 'timestamp', 'payload'])
        && data.name is string && data.name.size() <= 200
        && data.unit is string && data.unit.size() <= 100
        && data.view is string && data.view.size() <= 100
        && data.timestamp is int
        && data.payload is map;
    }

    // Rules for Sync
    match /sync/{syncId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(syncId) && isValidSyncPayload(request.resource.data);
    }

    // Rules for Drafts
    match /drafts/{draftId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(draftId) && isValidDraftDocument(request.resource.data);
      allow delete: if isSignedIn() && isValidId(draftId);
    }
  }
}
